# Vodou — "just works in a browser" container variant.
#
# Unlike the root ./Dockerfile (which needs a host X server), this image carries
# its own virtual display: Xvfb + a window manager + a VNC server + the noVNC
# web client. You run it and open http://localhost:8080 — no X server on the
# host, identical on Windows / macOS / Linux.
#
# Build from the REPO ROOT so the app source is in the build context:
#   docker build -f docker/Dockerfile.vnc -t msteier/vodou:latest .
#
# Trade-off: to run with no special flags, Chromium's sandbox is OFF by default
# here (QTWEBENGINE_DISABLE_SANDBOX=1). The startup banner says so. To keep the
# sandbox, run with:  --cap-add SYS_ADMIN -e QTWEBENGINE_DISABLE_SANDBOX=0

# Base pinned by digest (supply-chain hardening): a tag can be repointed at
# different code, a digest can't. This is python:3.14-slim as of the last
# update (2026-09-26) -- a pinned digest freezes in whatever CVEs existed at
# pin time, so bump it periodically (`docker pull python:3.14-slim` then
# `docker inspect --format='{{index .RepoDigests 0}}' python:3.14-slim`),
# not just when something's known to be wrong.
FROM python:3.14-slim@sha256:51dafde81dbdb6ebde285137a295cf18a47ca95234fe388a343719cb97305b3d

# ---- Runtime system libraries Qt6 + bundled Chromium dlopen, PLUS the headless
#      display stack (xvfb, a minimal WM, x11vnc). noVNC and websockify are
#      installed separately below, not via apt -- see that step for why. -----
# No GTK 3 / CUPS / ATK / gdk-pixbuf / cairo / pango: across Qt and Chromium only two
# optional Qt plugins link them -- the GNOME platform theme (loaded only on a
# GNOME-like desktop session) and the CUPS printer backend (Vodou never prints)
# -- and a running Vodou maps none of them. Dropping them removed 7 Medium and
# 19 Low Docker Scout findings with no change in behaviour.
RUN apt-get update && apt-get install --no-install-recommends -y \
        libgl1 libegl1 libgbm1 libglib2.0-0 libdbus-1-3 \
        libx11-6 libx11-xcb1 libxext6 libxrender1 libxcb1 \
        libxcb-glx0 libxcb-icccm4 libxcb-image0 libxcb-keysyms1 \
        libxcb-randr0 libxcb-render-util0 libxcb-render0 libxcb-shape0 \
        libxcb-shm0 libxcb-sync1 libxcb-util1 libxcb-xfixes0 \
        libxcb-xinerama0 libxcb-xkb1 libxcb-cursor0 \
        libxkbcommon0 libxkbcommon-x11-0 libxkbfile1 \
        libxcomposite1 libxdamage1 libxrandr2 libxi6 libxtst6 libxcursor1 \
        libnss3 libnspr4 libasound2t64 libpulse0 \
        libgssapi-krb5-2 \
        fonts-dejavu-core fontconfig \
        xvfb x11-utils evilwm x11vnc socat tini \
    && rm -rf /var/lib/apt/lists/*

# noVNC + websockify, installed directly instead of via apt: Debian's `novnc`
# package hard-depends on `websockify`, which in turn drags in python3-numpy,
# python3-redis, python3-jwcrypto and nodejs -- none of which noVNC's static
# web assets or websockify's actual runtime need, and which added ~40 CVEs to
# the image, including stale duplicate copies of cryptography/urllib3 sitting
# alongside the current ones pip installs below (found via Docker Scout).
# websockify via pip is the same upstream project without Debian's extra
# baggage; noVNC's web assets come straight from its own pinned, checksummed
# release tarball -- the identical v1.6.0 Debian's package used to ship.
RUN python -m pip install --no-cache-dir --disable-pip-version-check websockify
RUN cat > /tmp/fetch_novnc.py <<'EOF' \
    && python3 /tmp/fetch_novnc.py \
    && rm /tmp/fetch_novnc.py
import hashlib
import io
import tarfile
import urllib.request

URL = "https://github.com/novnc/noVNC/archive/refs/tags/v1.6.0.tar.gz"
SHA256 = "5066103959ef4e9b10f37e5a148627360dd8414e4cf8a7db92bdbd022e728aaa"
PREFIX = "noVNC-1.6.0/"

data = urllib.request.urlopen(URL, timeout=30).read()
digest = hashlib.sha256(data).hexdigest()
if digest != SHA256:
    raise SystemExit(f"noVNC tarball checksum mismatch: got {digest}")

with tarfile.open(fileobj=io.BytesIO(data)) as tar:
    members = []
    for member in tar.getmembers():
        if member.name == PREFIX.rstrip("/") or not member.name.startswith(PREFIX):
            continue
        member.name = member.name[len(PREFIX):]
        members.append(member)
    tar.extractall("/usr/share/novnc", members=members)
EOF

# Land http://localhost:8080/ straight on the auto-connecting viewer.
RUN printf '%s\n' \
    '<!doctype html><meta charset="utf-8">' \
    '<meta http-equiv="refresh" content="0; url=vnc.html?autoconnect=true&resize=scale&reconnect=true">' \
    > /usr/share/novnc/index.html

# ---- Python dependencies (cached separately from app code) --------------------
WORKDIR /app
COPY requirements.txt ./
RUN python -m pip install --no-cache-dir --disable-pip-version-check \
        -r requirements.txt \
    && python -m pip uninstall --yes --disable-pip-version-check pip
# pip is removed once every package is installed: nothing in the container
# needs it at runtime (the app user can't write site-packages, so the in-app
# engine updater can't install here anyway), and pip vendors its own copies of
# msgpack and setuptools' pkg_resources that Docker Scout flags as High
# (msgpack < 1.2.1, setuptools < 78.1.1) -- even the newest pip ships them.

# ---- Application source -------------------------------------------------------
COPY . .

# ---- Startup script: bring up the display stack, then launch Vodou ------------
RUN cat > /usr/local/bin/vodou-vnc <<'EOF' \
    && chmod +x /usr/local/bin/vodou-vnc
#!/bin/sh
set -e
export DISPLAY=:0
# A restarted container keeps its filesystem, so a stale X lock left by a
# previous run makes Xvfb abort with "Server is already active for display 0"
# and the whole stack crash-loops. Clear any leftover lock/socket first.
rm -f /tmp/.X0-lock /tmp/.X11-unix/X0 2>/dev/null || true
GEOM="${VNC_GEOMETRY:-1440x900}"
echo "[vodou] starting virtual display ${GEOM} ..."
Xvfb :0 -screen 0 "${GEOM}x24" -nolisten tcp &
# Wait until the X server actually accepts connections.
for i in $(seq 1 50); do
    xdpyinfo -display :0 >/dev/null 2>&1 && break
    sleep 0.2
done
# evilwm, not fluxbox: fluxbox needs imlib2, which pulls in libheif, librsvg,
# and jpeg-xl -- image decoders with open High CVEs that nothing else here
# uses. evilwm has no image dependencies at all. It needs an X core font, and
# its default isn't installed; 6x13 is built into Xvfb, so no font package is
# needed either (without -fn it exits at once: "couldn't find a font to use").
evilwm -fn 6x13 >/dev/null 2>&1 &
x11vnc -display :0 -forever -shared -nopw -rfbport 5900 -bg -quiet
websockify --web=/usr/share/novnc 8080 localhost:5900 >/dev/null 2>&1 &
if [ "${QTWEBENGINE_DISABLE_SANDBOX:-1}" = "1" ]; then
    export QTWEBENGINE_DISABLE_SANDBOX=1
    echo "[vodou] NOTE: Chromium sandbox is OFF (no-flags convenience mode)."
    echo "[vodou]       To keep it on: run with --cap-add SYS_ADMIN and"
    echo "[vodou]       -e QTWEBENGINE_DISABLE_SANDBOX=0"
fi
# Opt-in Ollama bridge for "Ask AI". Vodou requires a LOOPBACK endpoint (its
# on-device privacy guard), and inside a container 127.0.0.1 is the container,
# not the host. So instead of pointing Vodou off-box (which the guard rejects,
# rightly), we forward the container's own 127.0.0.1:11434 to the Ollama running
# on ${VODOU_OLLAMA_HOST} (e.g. host.docker.internal). Vodou keeps talking to
# 127.0.0.1 — the request stays on the same physical machine, just bridged.
if [ -n "${VODOU_OLLAMA_HOST:-}" ]; then
    OLLAMA_PORT="${VODOU_OLLAMA_PORT:-11434}"
    echo "[vodou] Ask AI: bridging 127.0.0.1:11434 -> ${VODOU_OLLAMA_HOST}:${OLLAMA_PORT}"
    socat TCP4-LISTEN:11434,bind=127.0.0.1,fork,reuseaddr \
        "TCP4:${VODOU_OLLAMA_HOST}:${OLLAMA_PORT}" >/dev/null 2>&1 &
fi
echo "[vodou] ready -> open  http://localhost:8080/  in your browser"
exec python main.py
EOF

# ---- Non-root user + persistent profile volume -------------------------------
# Pre-create ~/.vodou owned by the app user: Docker seeds the volume from this
# path (ownership included), so the non-root app can write its profile. Without
# it the mountpoint is created root-owned and the profile fails with EACCES.
RUN useradd --create-home --uid 10001 vodou \
    && mkdir -p /home/vodou/.vodou \
    && chown -R vodou:vodou /app /home/vodou/.vodou
USER vodou
ENV HOME=/home/vodou
VOLUME ["/home/vodou/.vodou"]

# Off by default in THIS variant so it runs with no special flags (see banner).
ENV QTWEBENGINE_DISABLE_SANDBOX=1
EXPOSE 8080

# Liveness: the noVNC web endpoint answering means the display stack + proxy are up.
HEALTHCHECK --interval=30s --timeout=5s --start-period=25s --retries=3 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8080/',timeout=4).status==200 else 1)" || exit 1

# tini as PID 1: reaps orphaned processes and forwards signals so `docker stop`
# shuts the stack down cleanly instead of waiting for SIGKILL.
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["/usr/local/bin/vodou-vnc"]
