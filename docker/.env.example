# Copy to .env and edit if needed:  cp .env.example .env
#
# Hostname the stack serves on. Leave as localhost to match Vodou's defaults
# (Vodou opens https://localhost/searxng and trusts localhost certificates).
SEARXNG_HOSTNAME=localhost

# SearXNG worker processes. 2 is fine for a single user; raise for a shared
# instance.
SEARXNG_WORKERS=2

# Model auto-pulled for AI summaries when you start with `--profile ai`.
# Any Ollama model tag works (e.g. llama3.2, mistral, gemma3:4b).
OLLAMA_MODEL=llama3.2

# Listen on this computer only. Ollama's API has no authentication, so
# 0.0.0.0 lets anyone on your network use, pull, or delete models. Set it to
# 0.0.0.0 only on a network you trust, to reach Ollama at <host-LAN-IP>:11434.
OLLAMA_BIND_ADDRESS=127.0.0.1

# htpasswd file for the noVNC viewer's LAN password (the reverse-proxy gate).
# setup.sh / setup.ps1 create it with a random password, shown once. Point
# this at your nginx's file (e.g. C:\nginx\conf\vodou.htpasswd); left empty,
# it defaults to viewer-auth/vodou.htpasswd in this folder.
VODOU_VIEWER_HTPASSWD=
